# shanwan Twin USB Joystick (receptor de 2 controles, vid 0x0810 pid 0x0001).
# Sem este arquivo o Android usa o Generic.kl: os botões viram BUTTON_1..10 e o aparelho
# não é marcado como "gamepad" -> o RetroArch trata como teclado e o jogo não recebe comando.
# Posições (dos 4 botões da direita), no padrão Android/Xbox: A embaixo, B direita, X esquerda, Y em cima.
key 288   BUTTON_Y
key 289   BUTTON_B
key 290   BUTTON_A
key 291   BUTTON_X
key 292   BUTTON_L1
key 293   BUTTON_R1
key 294   BUTTON_L2
key 295   BUTTON_R2
key 296   BUTTON_SELECT
key 297   BUTTON_START
key 298   BUTTON_THUMBL
key 299   BUTTON_THUMBR

axis 0x00 X
axis 0x01 Y
axis 0x02 Z
axis 0x03 RX
axis 0x04 RY
axis 0x05 RZ
axis 0x10 HAT_X
axis 0x11 HAT_Y
